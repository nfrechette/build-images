FROM ubuntu:26.04 as base

# This image supports:
#    - GCC 14.3.0, 15.2.0
#    - Clang 19.1.7, 20.1.8, 21.1.8, 22.1.8, 23.1.3
#    - armv7: only GCC 15.2.0 and Clang 22.1.2, the newest that the stock armhf repos have

# Architecture: amd64, arm64, or armv7
ARG ARCH

# Set a sensible locale
ENV LANG C.UTF-8

# Basics
RUN set -x && echo 'debconf debconf/frontend select Noninteractive' | debconf-set-selections && \
    apt-get update && \
    apt-get install -y -q apt-transport-https ca-certificates && \
    apt-get install -y -q curl gnupg && \
    apt-get install -y -q make git python3 cmake

# GCC
# The stock g++-16 is a pre-release snapshot, not GCC 16.1+, so we stop at 15
# armv7 only needs one version to test with
RUN apt-get update && \
    if [ "$ARCH" = "armv7" ]; then \
        apt-get install -y -q g++-15; \
    else \
        apt-get install -y -q g++-14 g++-15; \
    fi && \
    if [ "$ARCH" = "amd64" ]; then \
        apt-get install -y -q g++-14-multilib g++-15-multilib; \
    fi

# Clang
# 19 to 21 come from the stock repos (apt.llvm.org has no 19/20 for resolute and its 21 sorts
# below the stock one), 22 and 23 come from apt.llvm.org
# apt-key no longer exists, the LLVM key goes in its own keyring
# armv7 only needs one version to test with, apt.llvm.org has no armhf packages and the newest
# in the stock repos is 22
RUN if [ "$ARCH" = "armv7" ]; then \
        apt-get update && \
        apt-get install -y -q clang-22; \
    else \
        curl -sSL "http://apt.llvm.org/llvm-snapshot.gpg.key" | gpg --dearmor -o /usr/share/keyrings/llvm-snapshot.gpg && \
        echo "deb [signed-by=/usr/share/keyrings/llvm-snapshot.gpg] http://apt.llvm.org/resolute/ llvm-toolchain-resolute-22 main" | tee -a /etc/apt/sources.list > /dev/null && \
        echo "deb [signed-by=/usr/share/keyrings/llvm-snapshot.gpg] http://apt.llvm.org/resolute/ llvm-toolchain-resolute-23 main" | tee -a /etc/apt/sources.list > /dev/null && \
        apt-get update && \
        apt-get install -y -q clang-19 clang-20 clang-21 clang-22 clang-23; \
    fi

WORKDIR /project-src

CMD ["bash"]
